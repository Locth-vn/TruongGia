  "announcements": [
    {
      "id": "ann-open",
      "title": "Chào mừng đến với website nội bộ gia đình",
      "date": "",
      "content": "Trang nhà riêng của đại gia đình ông Trương Đình Bảng (họ Trương — bên bố) và bà Hoàng Thị Lệ Chi (họ Hoàng — bên mẹ), dành để lưu giữ gia phả các thế hệ, nhắc sinh nhật — ngày giỗ, chia sẻ thông báo và hình ảnh của các nhánh. Thành viên đăng nhập bằng tài khoản do quản trị viên cấp. Ai có tin tức, hình ảnh mới xin gửi về Ban quản trị để đăng lên.",
      "photo": null,
      "photos": [
        "img/gia-dinh-1.jpg",
        "img/gia-dinh-2.jpg"
      ],
      "author": "Admin",
      "authorName": "Quản trị viên",
